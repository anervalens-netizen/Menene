<?xml version="1.0" encoding="utf-8"?>
<ro.menene.app.ui.RatioFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:clickable="true"
    android:clipToOutline="true"
    android:elevation="7dp"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    app:ratioHeight="9"
    app:ratioWidth="16">

    <ImageView
        android:id="@+id/artwork"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fallbackNumber"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#55FFFFFF"
        android:textSize="70sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_center"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="13dp"
        android:src="@drawable/ic_play" />

    <TextView
        android:id="@+id/numberBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="11dp"
        android:background="@drawable/bg_episode_badge"
        android:textColor="@color/menene_white"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/completedBadge"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="top|end"
        android:layout_margin="11dp"
        android:background="@drawable/bg_completed_badge"
        android:gravity="center"
        android:text="@string/completed_mark"
        android:textColor="@color/menene_white"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/continueBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="11dp"
        android:background="@drawable/bg_continue_badge"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/continue_short"
        android:textColor="@color/menene_ink"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_scrim_bottom" />

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingStart="15dp"
        android:paddingTop="8dp"
        android:paddingEnd="15dp"
        android:paddingBottom="17dp"
        android:textColor="@color/menene_white"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="bottom"
        android:max="1000"
        android:progressBackgroundTint="#45FFFFFF"
        android:progressTint="@color/menene_yellow"
        android:visibility="gone" />
</ro.menene.app.ui.RatioFrameLayout>
