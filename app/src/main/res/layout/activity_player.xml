<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:keepScreenOn="true" />

    <ImageButton
        android:id="@+id/closeButton"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_translucent_round"
        android:contentDescription="@string/close_episode"
        android:padding="18dp"
        android:src="@drawable/ic_close" />

    <LinearLayout
        android:layout_width="70dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="18dp"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/volumeUpButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="@drawable/bg_translucent_round"
            android:contentDescription="@string/volume_up"
            android:padding="18dp"
            android:src="@drawable/ic_volume_up" />

        <ImageButton
            android:id="@+id/volumeDownButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_translucent_round"
            android:contentDescription="@string/volume_down"
            android:padding="18dp"
            android:src="@drawable/ic_volume_down" />
    </LinearLayout>

    <ImageView
        android:id="@+id/playPauseIndicator"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_player_center"
        android:contentDescription="@null"
        android:padding="24dp"
        android:src="@drawable/ic_pause"
        android:visibility="gone" />

</FrameLayout>
