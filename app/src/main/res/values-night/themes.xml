<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Menene" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="fontFamily">sans-serif-rounded</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/menene_yellow</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">true</item>
    </style>

    <style name="Theme.Menene.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/menene_yellow</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_menene_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Menene</item>
    </style>
</resources>
